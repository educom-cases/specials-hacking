  "forms": {
    "input": {
      "height": "2.5rem",
      "padding-x": "0.75rem",
      "padding-y": "0.625rem",
      "border": "1px solid rgba(255, 255, 255, 0.1)",
      "border-bottom": "1px solid rgba(255, 255, 255, 0.1)",
      "border-radius": "0.375rem",
      "background-color": "#282c34",
      "text-color": "#fff",
      "placeholder-color": "rgba(255, 255, 255, 0.4)"
    },
    "focus": {
      "border": "1px solid #3c7bfa",
      "border-bottom": "1px solid #3c7bfa",
      "outline-color": "rgba(60, 123, 250, 0.35)",
      "outline-width": "0"
    },
    "disabled": {
      "background-color": "rgba(255, 255, 255, 0.05)",
      "border": "1px solid rgba(255, 255, 255, 0.1)",
      "border-bottom": "1px solid rgba(255, 255, 255, 0.1)",
      "text-color": "rgba(255, 255, 255, 0.4)"
    },
    "error": {
      "border": "1px solid #fc3c3d",
      "border-bottom": "1px solid #fc3c3d",
      "text-color": "#fc3c3d"
    }
  }
